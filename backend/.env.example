# ─── Database ────────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string.
#
# Prefer the SESSION pooler (port 5432). The TRANSACTION pooler (port 6543) and
# PgBouncer generally cannot serve prepared statements; the app detects that
# from the URL and disables them, but session mode is the simpler default.
# SSL and pool size are derived from this URL too — see config/db.ts.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional overrides for the connection detection above.
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT=20
# DB_CONNECT_TIMEOUT=15
# DB_PREPARE=false     # force off behind a transaction pooler
# DB_SSL=true          # force on/off

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required. Must be >= 32 characters in production — the app refuses to boot
# otherwise. Generate: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption ──────────────────────────────────────────────────────────────
# Required in production. Encrypts stored GitHub tokens (AES-256-GCM).
# Must be exactly 64 hex characters. Generate: openssl rand -hex 32
# Rotating this makes every stored GitHub token undecryptable — users must
# reconnect their accounts.
ENCRYPTION_KEY=

# ─── Supabase (Storage) ──────────────────────────────────────────────────────
# Required in production. Uploads go to the private `workspace-files` bucket;
# with these unset the app falls back to local disk, which is wiped on every
# restart on a managed host — so production refuses to boot without them.
# The service role key bypasses row-level security. Server-side only, never
# expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Both are required in production, and both must be the real public origins
# with no trailing slash. They are compared to decide the refresh cookie's
# SameSite mode (see lib/cookies.ts): different sites → SameSite=None; Secure,
# which is the only combination a browser attaches to a cross-site refresh
# call. Get these wrong and every user is signed out 15 minutes after login.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Extra browser origins allowed to call the API and open a socket, beyond
# FRONTEND_URL. Comma-separated. Needed for apex-vs-www, a custom domain
# alongside the platform one, or preview deployments.
# CORS_ORIGINS=https://www.example.com,https://devsync.vercel.app

# Override the cookie attributes derived above. Only needed when a proxy puts
# the SPA and the API on one hostname, which the derivation cannot see.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Reverse proxy hop count (Nginx, Load Balancer, Render/Railway, Cloudflare).
# 1 = single proxy in front of the app (default). 0 = no proxy, direct exposure.
TRUST_PROXY_HOPS=1

# Apply pending migrations during boot instead of as a release step. Leave off
# where the platform supports a release/pre-deploy command — two instances
# booting at once would otherwise race to apply the same migration.
# RUN_MIGRATIONS_ON_BOOT=false

# Block sign-in until the email address is verified. On by default in
# production; set to false to opt out, or true to enable it elsewhere.
# REQUIRE_EMAIL_VERIFICATION=true

# ─── OAuth ───────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=

# ─── Zoom (Server-to-Server OAuth app) ───────────────────────────────────────
# Optional. Mints the meeting behind a channel's "Start call" button. One Zoom
# account hosts every meeting; joiners need no Zoom account of their own.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Optional. Sprint retrospectives and task duration estimates. Features degrade
# gracefully when unset.
GEMINI_API_KEY=

# ─── SMTP (email delivery) ───────────────────────────────────────────────────
# Real mail is only sent when NODE_ENV=production, or when SMTP_ALLOW_DEV=true.
# Otherwise verification / reset / invite links are logged to the server console.
#
# Reserved and non-deliverable domains (@demo.com, @example.com, *.test, *.local,
# ...) are never mailed even with sending on — they hard-bounce, and bounces are
# what get a sender flagged as a spammer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must match SMTP_USER for Gmail; a From it does not own is rewritten or rejected.
SMTP_FROM=
SMTP_ALLOW_DEV=false
# Hard ceiling per calendar day. 0 = default (500 in production, 25 otherwise).
SMTP_MAX_PER_DAY=0
