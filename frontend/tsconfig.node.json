{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    /* `composite` forces emit, so send it somewhere ignorable rather than
       letting `tsc -b` drop a stale vite.config.js next to the .ts source —
       Vite resolves the .js first and would then load the older config. */
    "outDir": "./node_modules/.tmp/node-config",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
