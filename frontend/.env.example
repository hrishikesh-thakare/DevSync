# Frontend Environment Variables
#
# Everything here is compiled into the bundle and is publicly readable. Only
# ever put publishable values in a VITE_ variable — never the Supabase service
# role key, and never an SMTP or OAuth client secret.

# The API's public origin, including the /api suffix. The Socket.io URL is
# derived from this by stripping /api, so there is no separate socket variable.
VITE_API_URL=http://localhost:3001/api

# To enable Supabase OAuth (Google/GitHub) and Storage:
# Supabase Dashboard → Settings → API
#   Project URL     → VITE_SUPABASE_URL
#   `anon` public   → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key
